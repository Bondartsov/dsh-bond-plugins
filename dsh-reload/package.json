{
  "name": "@local/dsh-reload",
  "version": "1.1.0",
  "license": "MIT",
  "engines": { "dsh": ">=0.2.1-0 <0.3.0" },
  "private": true,
  "type": "module",
  "description": "Reload button for DeepSeek Harness: restarts changed plugins and reloads the page.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "capabilities": ["network:ingress", "network:egress"],
    "labels": ["remote-access"],
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
