{
  "name": "@local/composer-cost-day",
  "version": "1.1.0",
  "license": "MIT",
  "engines": { "dsh": ">=0.2.1-0 <0.3.0" },
  "private": true,
  "type": "module",
  "description": "Daily spend ledger by model route, served to the composer cost cells.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "capabilities": ["network:ingress"],
    "labels": ["remote-access"],
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
