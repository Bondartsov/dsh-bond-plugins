{
  "name": "@local/dsh-peer-bus",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-session peer messaging, coordination claims and activity board for DeepSeek Harness",
  "main": "index.js",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:mutation": "node test/mutation.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/**/*.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
